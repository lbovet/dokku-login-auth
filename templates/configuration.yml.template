---
theme: 'auto'

server:
  address: 'tcp://:9091'
  endpoints:
    authz:
      auth-request:
        implementation: 'AuthRequest'

log:
  level: 'info'

identity_validation:
  reset_password:
    jwt_secret: '<JWT_SECRET>'

authentication_backend:
  file:
    path: '/config/users.yml'
    password:
      algorithm: 'argon2'
      argon2:
        variant: 'argon2id'
        iterations: 3
        memory: 65536
        parallelism: 4
        key_length: 32
        salt_length: 16

access_control:
  default_policy: 'deny'
  rules:
    # Portal self-access (login UI / static assets) must be pre-auth.
    - domain: '<AUTH_DOMAIN>'
      policy: 'bypass'
      resources:
        - '^/api/authz/auth-request([/?].*)?$'
        - '^/(static|locales)/.*$'
    # Per-app one_factor rules are generated by the plugin from each app's
    # state.json and its configured Dokku domains. They follow this portal
    # bypass rule in domain-specificity order. There is deliberately no
    # catch-all '*.<PARENT_DOMAIN>' rule: an app without a generated rule is
    # denied by default_policy: deny, which is the safe default.

session:
  secret: '<SESSION_SECRET>'
  cookies:
    - domain: '<PARENT_DOMAIN>'
      authelia_url: 'https://<AUTH_DOMAIN>'
      default_redirection_url: 'https://<AUTH_DOMAIN>'
      expiration: '1h'
      inactivity: '15m'

regulation:
  max_retries: 5
  find_time: '2m'
  ban_time: '5m'

storage:
  encryption_key: '<STORAGE_SECRET>'
  local:
    path: '/config/db.sqlite3'

notifier:
  disable_startup_check: true
  filesystem:
    filename: '/config/notification.txt'
